{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/solid",
    "ultracite/biome/jest",
    "ultracite/biome/vitest"
  ],
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "off"
      }
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
