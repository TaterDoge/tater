{
  "name": "tater-agent",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.4.3",
      "@tanstack/ai": "^0.42.0",
      "@opentui/core": "^0.4.5"
    }
  },
  "scripts": {
    "dev": "bun run packages/cli/src/main.ts",
    "build": "bun build packages/cli/src/main.ts --compile --outfile dist/tater-agent",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check-fix": "bun run check && bun run fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4"
  }
}
